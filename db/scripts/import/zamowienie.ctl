OPTIONS (SKIP=1, ERRORS=1000000, ROWS=5000, BINDSIZE=1048576)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE '/data/przygotowane/zamowienie.csv' "STR x'0D0A'"
APPEND INTO TABLE APTEKA.ZAMOWIENIE
FIELDS TERMINATED BY ';' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  ID INTEGER EXTERNAL,
  DostawcaID INTEGER EXTERNAL,
  DataZamowienia DATE "YYYY-MM-DD",
  PlanowanaDostawa DATE "YYYY-MM-DD",
  Status CHAR,
  WartoscZamowienia DECIMAL EXTERNAL,
  KodZamowienia CHAR
)
