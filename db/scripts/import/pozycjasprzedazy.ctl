OPTIONS (SKIP=1, ERRORS=1000000, ROWS=5000, BINDSIZE=1048576)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE '/data/przygotowane/pozycjasprzedazy.csv' "STR x'0D0A'"
APPEND INTO TABLE APTEKA.POZYCJASPRZEDAZY
FIELDS TERMINATED BY ';' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  ID INTEGER EXTERNAL,
  SprzedazID INTEGER EXTERNAL,
  LekID INTEGER EXTERNAL,
  Ilosc INTEGER EXTERNAL,
  CenaSprzedazy DECIMAL EXTERNAL,
  Rabat DECIMAL EXTERNAL,
  DataUjecia DATE "YYYY-MM-DD",
  KodPozycji CHAR
)
