OPTIONS (SKIP=1, ERRORS=1000000, ROWS=5000, BINDSIZE=1048576)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE '/data/przygotowane/pozycjazamowienia.csv' "STR x'0D0A'"
APPEND INTO TABLE APTEKA.POZYCJAZAMOWIENIA
FIELDS TERMINATED BY ';' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  ID INTEGER EXTERNAL,
  ZamowienieID INTEGER EXTERNAL,
  LekID INTEGER EXTERNAL,
  Ilosc INTEGER EXTERNAL,
  CenaZakupu DECIMAL EXTERNAL,
  DataDostarczenia DATE "YYYY-MM-DD",
  KodPozycji CHAR
)
