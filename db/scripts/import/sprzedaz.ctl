OPTIONS (SKIP=1, ERRORS=1000000, ROWS=5000, BINDSIZE=1048576)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE '/data/przygotowane/sprzedaz.csv' "STR x'0D0A'"
APPEND INTO TABLE APTEKA.SPRZEDAZ
FIELDS TERMINATED BY ';' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  ID INTEGER EXTERNAL,
  DataSprzedazy DATE "YYYY-MM-DD HH24:MI:SS",
  NumerParagonu CHAR,
  SposobPlatnosci CHAR,
  WartoscCalkowita DECIMAL EXTERNAL,
  KodKasy CHAR
)
